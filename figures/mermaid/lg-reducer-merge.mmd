graph TB
  subgraph no["NO reducer — value: str"]
    X0["state: value"] --> XA["node a returns<br/>value = 'from-a'"]
    X0 --> XB["node b returns<br/>value = 'from-b'"]
    XA --> XE["InvalidUpdateError:<br/>Can receive only one<br/>value per step"]
    XB --> XE
  end

  subgraph yes["WITH reducer — Annotated[list, operator.add]"]
    Y0["state: log"] --> YA["node a returns<br/>log = ['a']"]
    Y0 --> YB["node b returns<br/>log = ['b']"]
    YA --> YM["reducer merges:<br/>log = ['a', 'b']"]
    YB --> YM
  end

  classDef n fill:#F4F6F8,stroke:#1F4E79
  classDef bad fill:#FBE9E9,stroke:#9B2C2C,stroke-width:2px
  classDef good fill:#E8F4F0,stroke:#0E7C7B,stroke-width:2px
  class X0,XA,XB,Y0,YA,YB n
  class XE bad
  class YM good
